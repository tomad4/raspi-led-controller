
import asyncio
import time
import board
import neopixel
from bleak import BleakScanner, BleakClient
import logging

# === CONFIG ===
NUM_PIXELS = 239
PIXEL_PIN = board.D18
BRIGHTNESS = 0.6
HR_MAC = "E0:48:24:B5:48:92"
HR_CHAR_UUID = "00002a37-0000-1000-8000-00805f9b34fb"

# === STREFY ===
ZONE_COLORS = {
    "white":  (255, 255, 255),
    "blue":   (0, 102, 255),
    "green":  (0, 204, 0),
    "yellow": (255, 255, 102),
    "orange": (255, 165, 0),
    "red":    (255, 0, 0),
}

ZONE_ORDER = ["white", "blue", "green", "yellow", "orange", "red"]

def get_zone(hr):
    if hr < 93:
        return "white"
    elif 93 <= hr < 111:
        return "blue"
    elif 111 <= hr < 130:
        return "green"
    elif 130 <= hr < 148:
        return "yellow"
    elif 148 <= hr < 167:
        return "orange"
    elif 167 <= hr <= 180:
        return "red"
    else:
        return "blink"

# === LOGGING ===
logging.basicConfig(
    filename="/home/pi/led/heart.log",
    level=logging.DEBUG,
    format="%(asctime)s %(levelname)s: %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S"
)

pixels = neopixel.NeoPixel(PIXEL_PIN, NUM_PIXELS, brightness=BRIGHTNESS, auto_write=False)

# === ANIMATIONS ===
async def fade_from_center(color):
    center = NUM_PIXELS // 2
    max_offset = max(center, NUM_PIXELS - center)
    for offset in range(max_offset + 1):
        i = center + offset
        j = center - offset
        if 0 <= i < NUM_PIXELS:
            pixels[i] = color
        if 0 <= j < NUM_PIXELS:
            pixels[j] = color
        pixels.show()
        await asyncio.sleep(0.01)

async def pulsating_wave(zone_color):
    dim_color = tuple(max(c // 3, 1) for c in zone_color)
    pos = 0
    direction = 1
    while True:
        pixels.fill(zone_color)
        for i in range(10):
            idx = pos + i
            if 0 <= idx < NUM_PIXELS:
                pixels[idx] = dim_color
        pixels.show()
        await asyncio.sleep(0.05)
        pos += direction
        if pos + 10 >= NUM_PIXELS or pos <= 0:
            direction *= -1

async def idle_animation():
    pos = 0
    direction = 1
    while True:
        for zone in ZONE_ORDER:
            color = tuple(max(c // 8, 1) for c in ZONE_COLORS[zone])
            for _ in range(NUM_PIXELS * 2):  # przejście tam i z powrotem
                pixels.fill((0, 0, 0))
                for i in range(15):
                    idx = pos + i
                    if 0 <= idx < NUM_PIXELS:
                        pixels[idx] = color
                pixels.show()
                await asyncio.sleep(0.02)
                pos += direction
                if pos + 15 >= NUM_PIXELS or pos <= 0:
                    direction *= -1

async def blinking_red(duration=2):
    start = time.time()
    while time.time() - start < duration:
        pixels.fill((255, 0, 0))
        pixels.show()
        await asyncio.sleep(0.3)
        pixels.fill((0, 0, 0))
        pixels.show()
        await asyncio.sleep(0.3)

# === MAIN ===
async def handle_hr(_, data):
    global current_task, last_zone

    flags = data[0]
    hr = int.from_bytes(data[1:3], byteorder='little') if flags & 0x01 else data[1]

    logging.info(f"Tętno: {hr}")
    if hr < 30 or hr > 220:
        logging.warning("Tętno poza zakresem – ignoruję")
        return

    zone = get_zone(hr)
    if zone == last_zone:
        return

    last_zone = zone

    if current_task:
        current_task.cancel()
        try:
            await current_task
        except:
            pass

    if zone == "blink":
        current_task = asyncio.create_task(blinking_red(duration=2))
    else:
        color = ZONE_COLORS[zone]
        current_task = asyncio.create_task(pulsating_wave(color))

async def main():
    global current_task, last_zone
    last_zone = None
    current_task = asyncio.create_task(idle_animation())

    while True:
        logging.info("Szukam urządzenia HR...")
        devices = await BleakScanner.discover(timeout=10)
        found = next((d for d in devices if d.address == HR_MAC), None)

        if found:
            try:
                async with BleakClient(found.address) as client:
                    await client.start_notify(HR_CHAR_UUID, handle_hr)
                    while client.is_connected:
                        await asyncio.sleep(1)
            except Exception as e:
                logging.error(f"Błąd BLE: {type(e).__name__}: {e}")

        logging.warning("Rozłączono – wracam do idle")

        last_zone = None
        if current_task:
            current_task.cancel()
            try:
                await current_task
            except:
                pass

        current_task = asyncio.create_task(idle_animation())
        await asyncio.sleep(10)

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        pixels.fill((0, 0, 0))
        pixels.show()
        print("Wyłączono")
